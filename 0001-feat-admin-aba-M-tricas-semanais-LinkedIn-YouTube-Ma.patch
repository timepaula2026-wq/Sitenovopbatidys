+<body>
+<header>
+  <div class="row" style="align-items:center;gap:16px">
+    <h1>Métricas semanais</h1>
+    <nav class="row" style="gap:6px">
+      <a href="admin.html">CRM</a>
+      <a href="metricas.html" aria-current="page">Métricas</a>
+    </nav>
+  </div>
+  <div class="row">
+    <div>
+      <label class="l" for="semana">Segunda-feira</label>
+      <input type="date" id="semana">
+    </div>
+    <button class="ghost" id="btn-hoje">Semana atual</button>
+    <button id="btn-salvar">Salvar semana</button>
+    <span class="msg" id="msg" role="status"></span>
+  </div>
+</header>
+
+<section class="cards" id="cards"></section>
+
+<section class="blocos">
+  <div class="bloco"><h2>LinkedIn</h2>
+    <div class="campo"><label class="l" for="f_linkedin_impressoes">Impressões (7 dias)</label><input type="number" min="0" id="f_linkedin_impressoes"></div>
+    <div class="campo"><label class="l" for="f_linkedin_posts">Posts publicados</label><input type="number" min="0" id="f_linkedin_posts"></div>
+    <div class="campo"><label class="l" for="f_linkedin_seguidores">Seguidores totais</label><input type="number" min="0" id="f_linkedin_seguidores"></div>
+  </div>
+  <div class="bloco"><h2>YouTube</h2>
+    <div class="campo"><label class="l" for="f_youtube_views">Views</label><input type="number" min="0" id="f_youtube_views"></div>
+    <div class="campo"><label class="l" for="f_youtube_inscritos">Inscritos totais</label><input type="number" min="0" id="f_youtube_inscritos"></div>
+    <div class="campo"><label class="l" for="f_youtube_inscritos_novos">Inscritos novos</label><input type="number" min="0" id="f_youtube_inscritos_novos"></div>
+    <div class="campo"><label class="l" for="f_youtube_horas">Horas de exibição</label><input type="number" min="0" step="0.1" id="f_youtube_horas"></div>
+  </div>
+  <div class="bloco"><h2>ManyChat</h2>
+    <div class="campo"><label class="l" for="f_manychat_envios">Envios (automação novo seguidor)</label><input type="number" min="0" id="f_manychat_envios"></div>
+    <div class="campo"><label class="l" for="f_manychat_cliques">Cliques</label><input type="number" min="0" id="f_manychat_cliques"></div>
