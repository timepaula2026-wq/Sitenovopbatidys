+  </div>
+</section>
+
+<section>
+  <div class="tabela"><table>
+    <thead><tr>
+      <th>Semana</th><th>LI impr.</th><th>LI posts</th><th>LI seg.</th>
+      <th>YT views</th><th>YT inscr.</th><th>YT novos</th><th>YT horas</th>
+      <th>MC envios</th><th>MC cliques</th><th>MC novos</th>
+      <th>Eduzz vendas</th><th>Eduzz R$</th><th>Leads CRM</th><th>Convertidos</th>
+    </tr></thead>
+    <tbody id="rows"></tbody>
+  </table></div>
+  <p class="vazio" id="vazio" hidden>Nenhuma semana registrada ainda.</p>
+</section>
+
+<script>
+(() => {
+  const API = 'https://fhfphlqrgtabkiqoywea.supabase.co/functions/v1/pb-crm-admin';
+  const CAMPOS = ['linkedin_impressoes','linkedin_posts','linkedin_seguidores','youtube_views','youtube_inscritos','youtube_inscritos_novos','youtube_horas','manychat_envios','manychat_cliques','manychat_novos_seguidores','eduzz_vendas','eduzz_receita'];
+  const $ = id => document.getElementById(id);
+  let senha = '', linhas = [], leads = [];
+
+  const isoLocal = d => [d.getFullYear(), String(d.getMonth()+1).padStart(2,'0'), String(d.getDate()).padStart(2,'0')].join('-');
+  const segunda = iso => { const [y,m,d] = iso.split('-').map(Number); const x = new Date(y, m-1, d); x.setDate(x.getDate() - ((x.getDay()+6)%7)); return isoLocal(x); };
+  const soma = (iso, n) => { const [y,m,d] = iso.split('-').map(Number); return isoLocal(new Date(y, m-1, d+n)); };
+  const num = v => (v === null || v === undefined || v === '' || isNaN(+v)) ? null : +v;
+  const fmt = (v, money) => v === null || v === undefined ? '—' : Number(v).toLocaleString('pt-BR', money ? {style:'currency', currency:'BRL'} : {maximumFractionDigits:1});
+  const br = iso => { const [y,m,d] = iso.split('-'); return d+'/'+m+'/'+y; };
+
+  function crmDaSemana(iso) {
+    const ini = new Date(iso + 'T00:00:00-03:00');
+    const fim = new Date(soma(iso, 7) + 'T00:00:00-03:00');
+    const del = leads.filter(l => { const t = new Date(l.created_at || l.criado_em || 0); return t >= ini && t < fim; });
+    return { leads: del.length, convertidos: del.filter(l => l.status === 'convertido').length };
+  }
+
+  function preencherForm(iso) {
+    const r = linhas.find(x => x.semana === iso) || {};
+    CAMPOS.forEach(c => { $('f_'+c).value = r[c] ?? ''; });
+    const crm = crmDaSemana(iso);
+    $('crm-auto').textContent = crm.leads + ' leads · ' + crm.convertidos + ' convertidos';
+  }
+
+  function desenhar() {
+    const sem = $('semana').value;
+    const ant = linhas.find(x => x.semana === soma(sem, -7));
+    const cur = linhas.find(x => x.semana === sem) || {};
+    const cards = [
+      ['LinkedIn impressões', 'linkedin_impressoes', false],
+      ['YouTube views', 'youtube_views', false],
+      ['ManyChat novos', 'manychat_novos_seguidores', false],
+      ['Eduzz receita', 'eduzz_receita', true],
+    ];
+    $('cards').innerHTML = cards.map(([lab, k, money]) => {
+      const c = num(cur[k]), p = ant ? num(ant[k]) : null;
+      let d = 'sem comparação', cls = '';
+      if (c !== null && p !== null && p !== 0) { const pct = (c-p)/Math.abs(p)*100; d = (pct>0?'▲ ':pct<0?'▼ ':'• ')+Math.abs(pct).toLocaleString('pt-BR',{maximumFractionDigits:1})+'% vs. semana anterior'; cls = pct>0?'up':pct<0?'down':''; }
+      return `<div class="card"><div class="l" style="font-size:11px;color:var(--fg3);text-transform:uppercase">${lab}</div><div class="v">${fmt(c, money)}</div><div class="d ${cls}">${d}</div></div>`;
+    }).join('');
+
+    const body = $('rows'); body.textContent = '';
+    $('vazio').hidden = linhas.length > 0;
+    linhas.forEach(r => {
+      const crm = crmDaSemana(r.semana);
+      const tr = document.createElement('tr');
+      if (r.semana === sem) tr.className = 'on';
+      const vals = [br(r.semana), fmt(r.linkedin_impressoes), fmt(r.linkedin_posts), fmt(r.linkedin_seguidores),
+        fmt(r.youtube_views), fmt(r.youtube_inscritos), fmt(r.youtube_inscritos_novos), fmt(r.youtube_horas),
+        fmt(r.manychat_envios), fmt(r.manychat_cliques), fmt(r.manychat_novos_seguidores),
+        fmt(r.eduzz_vendas), fmt(r.eduzz_receita, true), String(crm.leads), String(crm.convertidos)];
+      vals.forEach(v => { const td = document.createElement('td'); td.textContent = v; tr.appendChild(td); });
+      tr.addEventListener('click', () => { $('semana').value = r.semana; preencherForm(r.semana); desenhar(); });
+      body.appendChild(tr);
+    });
+  }
+
+  async function carregar() {
+    const h = { 'X-Admin-Password': senha };
+    try {
+      const [rm, rl] = await Promise.all([
+        fetch(API + '?action=metricas_list', { headers: h }),
+        fetch(API + '?action=list', { headers: h }),
+      ]);
+      if (rm.status === 401 || rl.status === 401) { location.href = 'admin.html'; return; }
+      const dm = await rm.json(); const dl = await rl.json();
+      linhas = dm.rows || [];
+      leads = dl.leads || [];
+    } catch (e) {
+      $('msg').textContent = 'Erro ao carregar. Recarregue a página.';
+    }
+    preencherForm($('semana').value);
+    desenhar();
+  }
+
+  async function salvar() {
+    const sem = $('semana').value;
+    if (!sem) { $('msg').textContent = 'Escolha uma data.'; return; }
+    const semana = segunda(sem);
+    const payload = { semana };
+    CAMPOS.forEach(c => { payload[c] = num($('f_'+c).value); });
+    const crm = crmDaSemana(semana);
+    payload.crm_leads = crm.leads; payload.crm_convertidos = crm.convertidos;
+    $('btn-salvar').disabled = true; $('msg').textContent = 'Salvando…';
+    try {
+      const r = await fetch(API + '?action=metricas_save', {
+        method: 'POST', headers: { 'X-Admin-Password': senha, 'Content-Type': 'application/json' },
+        body: JSON.stringify(payload)
+      });
+      const d = await r.json();
+      if (!r.ok || d.ok === false) throw new Error(d.error || 'erro');
+      $('semana').value = semana;
+      $('msg').textContent = 'Semana de ' + br(semana) + ' salva.';
+      await carregar();
+    } catch (e) {
+      $('msg').textContent = 'Não foi possível salvar: ' + e.message;
+    } finally { $('btn-salvar').disabled = false; }
+  }
+
+  $('semana').addEventListener('change', e => { if (e.target.value) { $('semana').value = segunda(e.target.value); preencherForm($('semana').value); desenhar(); } });
+  $('btn-hoje').addEventListener('click', () => { $('semana').value = segunda(isoLocal(new Date())); preencherForm($('semana').value); desenhar(); });
+  $('btn-salvar').addEventListener('click', salvar);
+
+  (function init(){
+    $('semana').value = segunda(isoLocal(new Date()));
+    try { senha = localStorage.getItem('crm_pw') || ''; } catch (_) {}
+    if (!senha) { location.href = 'admin.html'; return; }
+    carregar();
+  })();
+})();
+</script>
+</body>
+</html>
