+  </div>
+  <div class="bloco"><h2>Vendas Eduzz (ebook)</h2>
+    <div class="campo"><label class="l" for="f_eduzz_vendas">Vendas na semana</label><input type="number" min="0" id="f_eduzz_vendas"></div>
+    <div class="campo"><label class="l" for="f_eduzz_receita">Receita (R$)</label><input type="number" min="0" step="0.01" id="f_eduzz_receita"></div>
